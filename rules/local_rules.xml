<!--
  Règles de détection personnalisées
  À déployer dans : /var/ossec/etc/rules/local_rules.xml
  Les IDs custom doivent être >= 100000 pour ne pas entrer en conflit
  avec le ruleset officiel Wazuh.
  Recharger : sudo systemctl restart wazuh-manager
-->

<group name="local,syslog,sshd,">

  <!-- Escalade : élève le niveau quand de multiples échecs SSH
       proviennent d'une même source (complète les règles natives 5710/5712) -->
  <rule id="100001" level="12" frequency="6" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>Brute force SSH probable : échecs répétés depuis $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>

  <!-- Connexion SSH réussie hors plage horaire (exemple : 22h-6h) -->
  <rule id="100002" level="8">
    <if_sid>5715</if_sid>
    <time>10:00 pm - 6:00 am</time>
    <description>Connexion SSH réussie en dehors des heures ouvrées depuis $(srcip)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

</group>

<group name="local,syscheck,">

  <!-- Alerte renforcée sur modification de fichiers critiques d'authentification -->
  <rule id="100010" level="12">
    <if_group>syscheck</if_group>
    <field name="file">/etc/(passwd|shadow|sudoers)$</field>
    <description>Modification d'un fichier d'authentification critique : $(file)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,windows,sysmon,">

  <!-- PowerShell encodé en base64 (technique d'obfuscation d'attaquant) -->
  <rule id="100020" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-e(nc|ncodedcommand)?\s</field>
    <description>PowerShell encode (base64) detecte : possible obfuscation malveillante</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Tuning : faux positif PowerShell Execution Policy test -->
  <!-- Le fichier __PSScriptPolicyTest_ est créé automatiquement par PowerShell -->
  <!-- pour tester l'Execution Policy. On abaisse le niveau pour réduire le bruit. -->
  <rule id="100030" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">__PSScriptPolicyTest_</field>
    <description>PowerShell Execution Policy test (faux positif connu, ignore)</description>
  </rule>

</group>